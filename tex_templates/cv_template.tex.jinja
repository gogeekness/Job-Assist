\renewcommand{\familydefault}{\sfdefault}

\definecolor{sidebar}{HTML}{2F6D92}
\definecolor{barshade}{HTML}{ECECEC}
\definecolor{darktext}{HTML}{1A1A1A}
\definecolor{sidebartext}{HTML}{FFFFFF}

\pagestyle{empty}
\setlength{\parindent}{0pt}
\setlength{\fboxsep}{9pt}
\color{darktext}

\newlength{\sidebarwidth}
\newlength{\sidebartextwidth}
\newlength{\maincolwidth}
\setlength{\sidebarwidth}{5.2cm}
\setlength{\sidebartextwidth}{\dimexpr\sidebarwidth-2\fboxsep\relax}
\setlength{\maincolwidth}{\dimexpr\textwidth-\sidebarwidth-0.4cm\relax}

\newlength{\jobgap}
\setlength{\jobgap}{10pt}
\newlength{\sidespace}
\setlength{\sidespace}{16pt}

\newcommand{\sideskill}[1]{\vspace{4pt}\textbf{#1}\par}

% minipage width is maincolwidth minus 2*fboxsep, not maincolwidth itself --
% \colorbox pads its content by \fboxsep on each side, so wrapping a
% full-maincolwidth minipage overflows the column by exactly 2*fboxsep
% (confirmed: 9pt fboxsep -> consistent 18pt "Overfull \hbox" on every
% job-header line before this fix).
\newcommand{\jobheader}[3]{%
  \noindent
  \colorbox{barshade}{%
    \begin{minipage}[t]{\dimexpr\maincolwidth-2\fboxsep\relax}
      \large
      \textbf{#1}\hfill\textbf{#2}\\
      \textbf{#3}
    \end{minipage}%
  }\\[2pt]
}

\newcommand{\sidebarbox}[1]{%
  \colorbox{sidebar}{%
    \begin{minipage}[t][\dimexpr\textheight-24pt\relax][t]{\sidebartextwidth}
      \small
      \color{sidebartext}
      #1
    \end{minipage}%
  }%
}

