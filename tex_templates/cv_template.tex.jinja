\noindent
\sidebarbox{%
\BLOCK{if photo_path}
  \begin{center}
    \reflectbox{\includegraphics[width=3cm]{\VAR{photo_path}}}
  \end{center}
  \vspace{10pt}
\BLOCK{endif}

  \textbf{\LARGE Details:}\\
  \VAR{location}\\
  \VAR{phone}\\
  \href{mailto:\VAR{email}}{\VAR{email}}

  \vspace{\sidespace}
  \textbf{\large Nationality:}\\
