\BLOCK{endif}

  \vspace{\sidespace}
  \textbf{\LARGE Skills:}
\BLOCK{for cat in skill_categories}

  {\large\sideskill{\VAR{cat.label}}\par}
  \begin{itemize}[leftmargin=1.1em, itemsep=0pt, topsep=2pt]
\BLOCK{for item in cat.skills}
    \item \VAR{item}
\BLOCK{endfor}
  \end{itemize}
\BLOCK{endfor}
}%
\hfill
\begin{minipage}[t]{\maincolwidth}
  \vspace{\fboxsep}
{\Huge\textbf{\VAR{name}}\par}
\vspace{2pt}
{\LARGE\textbf{\VAR{title}}\par}
\vspace{8pt}

