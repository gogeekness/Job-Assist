% ============================================================
%  Single-column CV style -- no sidebar. Skills near the top,
%  education/certificates at the bottom. Positions flagged
%  "earlier" (see POSITION_BULLET_TARGETS in generate_cv.py) render
%  as a compact list at the end of Experience instead of a full
%  entry. Compiles with plain pdflatex.
% ============================================================
\documentclass[10.5pt]{article}

\usepackage[a4paper, top=1.0cm, bottom=1.0cm, left=1.0cm, right=1.0cm]{geometry}
\usepackage{xcolor}
\usepackage{enumitem}
\usepackage[hidelinks]{hyperref}
\usepackage{titlesec}
\usepackage[T1]{fontenc}
\usepackage{amssymb}
\usepackage{graphicx}

\IfFileExists{DejaVuSans.sty}{%
  \usepackage{DejaVuSans}%
}{%
  \IfFileExists{tgheros.sty}{%
    \usepackage[scaled]{tgheros}%
  }{}%
}
\renewcommand{\familydefault}{\sfdefault}

\definecolor{accent}{HTML}{2F6D92}
\definecolor{darktext}{HTML}{1A1A1A}

% Per-page-area spacing -- tune each independently. To fine-tune one
% specific job's PDF, hand-edit its generated .tex (CV Review's
% recompile textarea) and swap an individual \vspace{\jobgappageA} to
% \jobgappageB (or vice versa) for whichever Experience entries actually
% land on that CV's page 2 -- the template can't know that in advance
% since it depends on how much content a given job pulls in.
\newlength{\introspace}
\setlength{\introspace}{9pt}    % header area: Profile + Skills
\newlength{\jobgappageA}
\setlength{\jobgappageA}{6pt}   % gap between Experience entries -- page 1 default
\newlength{\jobgappageB}
\setlength{\jobgappageB}{6pt}   % gap between Experience entries -- page 2 (hand-assign per job)
\newlength{\outrospace}
\setlength{\outrospace}{9pt}    % gap between Current Project and Education
\newlength{\cvbuffercerts}
\setlength{\cvbuffercerts}{0pt}

\pagestyle{empty}
\setlength{\parindent}{0pt}
% Ragged-right (not fully justified) everywhere -- justification stretches
% inter-word spacing to fill the line, which on a short wrapped line (e.g.
% a long summation sentence wrapping to 2 lines) can open a visibly wide
% gap between a couple of words. Standard for CVs anyway.
\raggedright
\color{darktext}

\titleformat{\section}
  {\Large\bfseries\color{accent}}
  {}{0em}{}
  [\vspace{0pt}{\color{accent}\hrule height 1pt}\vspace{2pt}]
\titlespacing*{\section}{0pt}{9pt}{1pt}

% #1 job title  #2 dates  #3 company/context line  #4 location
\newcommand{\jobentry}[4]{%
\noindent
    \begin{minipage}[t]{\linewidth}
      \large
      \textbf{#1}\hfill\textbf{#2}\\\textbf{#3}\hfill\textbf{#4}
    \end{minipage}%
}

% Equal thirds, \makebox (not \parbox) -- keeps each cell's content on one
% line and simply aligned within its box rather than wrapping. Relies on
% profile.json's nationality/visa staying reasonably short (they don't need
% to wrap, unlike the old "EU Blue card (Germany)" phrasing this was
% originally built around).
\newcommand{\IntroBlock}[6]{%
  \noindent
    \begin{minipage}[t]{\linewidth}
    \normalsize
    \makebox[0.33\linewidth][l]{\textbf{#1}}%
    \makebox[0.33\linewidth][c]{\textbf{#2}}%
    \makebox[0.33\linewidth][r]{\textbf{#3}}

    \makebox[0.33\linewidth][l]{\textbf{#4}}%
    \makebox[0.33\linewidth][c]{\textbf{#5}}%
    \makebox[0.33\linewidth][r]{\textbf{#6}}
    \end{minipage}%
  }

\begin{document}

% ============================================================
%  HEADER
% ============================================================
\BLOCK{if photo_path}
\noindent
\begin{minipage}[t]{0.76\linewidth}
\raggedright
  {\color{accent}\Huge\textbf{\VAR{name}}}\\[4pt]
  \color{darktext}
  {\textbf{\Large \VAR{title}}}\\[6pt]
  {\small
  \IntroBlock
      {\VAR{location}}
      {\VAR{phone}}
      {\href{mailto:\VAR{email}}{\VAR{email}}}
      {\VAR{nationality_line}}
      {\VAR{languages_line}}
      {\BLOCK{if links}\href{\VAR{links[0].url}}{\VAR{links[0].label}}\BLOCK{endif}}
  }
\end{minipage}\hfill
\begin{minipage}[t]{0.20\linewidth}
  \includegraphics[width=\linewidth]{\VAR{photo_path}}
\end{minipage}
\BLOCK{else}
\begin{center}
  {\color{accent}\Huge\textbf{\VAR{name}}}\\[4pt]
  \color{darktext}
  {\textbf{\Large \VAR{title}}}\\[6pt]
  {\small
  \IntroBlock
      {\VAR{location}}
      {\VAR{phone}}
      {\href{mailto:\VAR{email}}{\VAR{email}}}
      {\VAR{nationality_line}}
      {\VAR{languages_line}}
      {\BLOCK{if links}\href{\VAR{links[0].url}}{\VAR{links[0].label}}\BLOCK{endif}}
  }
\end{center}
\BLOCK{endif}

% ============================================================
%  PROFILE
% ============================================================
\section*{\VAR{labels.profile}}
\vspace{\introspace}
\large{\VAR{intro}}

% ============================================================
%  SKILLS
% ============================================================
\section*{\VAR{labels.skills}}
\vspace{\introspace}
\begin{itemize}[leftmargin=1.4em, itemsep=1pt, topsep=2pt]
\BLOCK{for cat in skill_categories}
  \item \textbf{\VAR{cat.label}:} \BLOCK{for s in cat.skills}\VAR{s}\BLOCK{if not loop.last} \textbullet{} \BLOCK{endif}\BLOCK{endfor}
\BLOCK{endfor}
\end{itemize}
\vspace{\introspace}

% ============================================================
%  EXPERIENCE
% ============================================================
\section*{\VAR{labels.experience}}
\vspace{\jobgappageA}
\BLOCK{for g in full_groups}
\jobentry{\VAR{g.position_title}}{\VAR{g.period}}{\VAR{g.employer}}{\VAR{g.location}}
\vspace{2pt}
\begin{itemize}[leftmargin=1.4em, itemsep=1pt, topsep=3pt]
\item[$\blacktriangleright$] \textbf{\VAR{g.summary}}
\BLOCK{for bullet in g.bullets}
  \item \VAR{bullet}
\BLOCK{endfor}
\end{itemize}
\vspace{\jobgappageA}
\BLOCK{endfor}

% ============================================================
%  EARLIER
% ============================================================
\BLOCK{if earlier_groups}
\section*{\VAR{labels.earlier}}
\begin{itemize}[leftmargin=1.2em, itemsep=2pt, topsep=4pt]
\BLOCK{for g in earlier_groups}
  \item \textbf{\VAR{g.position_title} --- \VAR{g.employer} (\VAR{g.period}):} \\ \VAR{g.summary}
\BLOCK{endfor}
\end{itemize}
\BLOCK{endif}

% ============================================================
%  CURRENT PROJECT
% ============================================================
\BLOCK{if projects}
\section*{\VAR{labels.current_project}}
\BLOCK{for p in projects}
\textbf{\VAR{p.title} (\VAR{p.period}):} \VAR{p.summary}
\BLOCK{endfor}
\vspace{\outrospace}
\BLOCK{endif}

% ============================================================
%  EDUCATION & CERTIFICATIONS
% ============================================================
\section*{\VAR{labels.education[:-1]} \& \VAR{labels.certificates}}
\BLOCK{for e in education}
\large\textbf{\VAR{e.degree}, \VAR{e.school} (\VAR{e.year})}\vspace{0pt}
\BLOCK{endfor}
\begin{center}
\begin{tabular}{lcr}
\BLOCK{for c in certificates}
  \vspace{\cvbuffercerts}
  \textbf{\large \VAR{c.name}} & \VAR{c.id} & \VAR{c.date}\\
\BLOCK{endfor}
\end{tabular}
\end{center}
\end{document}
