# venv
.venv/
Include/
Lib/
Scripts/
pyvenv.cfg

__pycache__/
*.pyc

.idea/

# runtime data
jobs.db
HPC.csv
bool

# personal career data - never enters git history
# (no trailing slash: LateX_Docs/CVs_Job_Dos are symlinks, and a
# trailing-slash pattern only matches real directories, not symlinks
# to directories -- would silently NOT exclude them otherwise)
richard_cv_master_bullet_bank_g_update.csv
richard_cv_master_bullet_bank_g_update.csv.bak-*
bullet_bank_*.csv
bullet_bank_*.csv.bak-*
bullet-proof-out.md
LateX_Docs
CVs_Job_Dos
generated/

# local settings/config (user-specific paths, API keys)
.env
config.local.json
bullet_store_cache.json
bullet_store_cache_*.json
profile.local.json
active-settings/
backups/

# profiles: real profiles hold personal data and stay local; only the
# generic _skeleton (and its .gitkeep stubs) is tracked.
.active_profile
profiles/*
!profiles/_skeleton/
profiles/_skeleton/generated_cvs/*
!profiles/_skeleton/generated_cvs/.gitkeep
profiles/_skeleton/generated_cover_letters/*
!profiles/_skeleton/generated_cover_letters/.gitkeep
