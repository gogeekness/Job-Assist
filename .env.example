# Copy to .env and fill in — never commit the real .env (already gitignored).

# stub (default, free/local keyword scoring) | anthropic | openai | ollama
LLM_BACKEND=stub

# Only needed when LLM_BACKEND=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Cheap/Haiku tier — deliberate choice while iterating, not the default in llm_plugin.py
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Only needed when LLM_BACKEND=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Only needed when LLM_BACKEND=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional: override where cv_bank.py looks for personal source data,
# instead of the LateX_Docs/ and CVs_Job_Dos/ symlinks at repo root.
# CV_BANK_TEX_DIR=/path/to/your/latex-cvs
# CV_BANK_ODT_DIR=/path/to/your/cv-archive
# CV_BANK_CSV_PATH=/path/to/your/bullet-bank.csv
